{
  "name": "bp-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply bp-log-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bp-log-db --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "jspdf": "^2.5.2",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "20.17.12",
    "@types/react": "19.1.7",
    "@types/react-dom": "19.1.7",
    "typescript": "5.7.2",
    "wrangler": "^4.86.0"
  }
}
