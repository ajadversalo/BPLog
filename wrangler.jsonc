{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bp-log",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bp-log-db",
			"database_id": "b92b16ed-bc7a-4cd0-92a1-d5616cf25d23",
			"migrations_dir": "migrations"
		},
		{
			"binding": "bp_log_db",
			"database_name": "bp-log-db",
			"database_id": "b92b16ed-bc7a-4cd0-92a1-d5616cf25d23"
		}
	],
	"observability": {
		"enabled": true
	}
}